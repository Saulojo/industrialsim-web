      "water": "#C3D0DC",
      "alarm-1": "#C8102E",
      "on-alarm-1": "#FFFFFF",
      "alarm-1-text": "#B00020",
      "alarm-1-surface": "#FDE8EA",
      "alarm-2": "#F28C00",
