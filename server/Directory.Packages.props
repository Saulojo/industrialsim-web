<Project>
  <!-- Versões centralizadas dos pacotes NuGet. Conferir a licença antes de adicionar (MIT, Apache-2.0, BSD). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Apache-2.0 -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
