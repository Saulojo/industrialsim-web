{
  "$description": "Tokens de design do IndustrialSim Web (Etapa D1). Fonte para a Etapa D2: cada chave de 'color' vira a variável CSS --color-<chave>; as demais seções viram --<seção>-<chave> (ex.: space.4 → --space-4). Contraste conferido por tools/design/contraste.mjs (resultado em docs/design/contraste.md).",
  "version": "D1-1",
  "font": {
    "family-base": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', roboto, arial, sans-serif",
    "family-mono": "'IBM Plex Mono', ui-monospace, 'Cascadia Mono', consolas, monospace",
    "weight-regular": 400,
    "weight-medium": 500,
    "weight-bold": 600,
    "line-height-base": 1.5,
    "line-height-tight": 1.2
  },
  "font-size": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.25rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "value-lg": "2.5rem"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "line-width": {
    "border": "1px",
    "control": "1px",
    "pipe": "3px",
    "trend": "2px",
    "focus": "2px",
    "alarm-outline": "1.5px"
  },
  "size": {
    "target-min": "24px",
    "target-comfortable": "44px",
    "target-vr": "64px"
  },
  "shadow": {
    "popover": "0 4px 16px rgb(0 0 0 / 18%)",
    "dialog": "0 8px 24px rgb(0 0 0 / 25%)"
  },
  "color": {
    "light": {
      "bg": "#E9EBED",
      "surface": "#FFFFFF",
      "surface-sunken": "#F3F4F6",
      "border": "#CDD2D7",
