      "overlay": "rgb(0 0 0 / 60%)"
    }
  },
  "contrastPairs": [
    { "fg": "text", "bg": "bg", "min": 4.5, "use": "Texto sobre o fundo da IHM" },
    { "fg": "text", "bg": "surface", "min": 4.5, "use": "Texto em painéis" },
    { "fg": "text", "bg": "surface-sunken", "min": 4.5, "use": "Texto em áreas rebaixadas (tabelas, campos)" },
    { "fg": "text-muted", "bg": "bg", "min": 4.5, "use": "Rótulos e textos secundários sobre o fundo" },
