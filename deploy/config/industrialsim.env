# Configuração do servidor nesta instalação (Etapa 9A). Copiado para /etc/industrialsim/industrialsim.env pelo
# install.sh só na primeira vez: as mudanças feitas na VM ficam. Depois de editar: sudo systemctl restart industrialsim
#
# Qualquer chave do appsettings.json pode ser trocada aqui, com "__" no lugar de ":"
# (ex.: Simulation:Instances:MaxInstances vira Simulation__Instances__MaxInstances).

ASPNETCORE_ENVIRONMENT=Production

# Kestrel só no loopback: de fora, o site entra pelo Caddy, na 443 (RNF06).
ASPNETCORE_URLS=http://127.0.0.1:5080

# Gravações de ensaio fora da pasta do programa, que é só leitura (D34).
Simulation__Instances__RecordingDirectory=/var/lib/industrialsim/recordings

# Limite de plantas em execução (padrão do appsettings: 40). O teste de carga crescente precisa de mais:
# Simulation__Instances__MaxInstances=300

# Endereço que a IHM mostra para o mestre Modbus; vazio usa o endereço da página.
# Simulation__Socket__PublicAddress=
