{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Simulation": {
    "ScenarioDirectory": "scenarios",
    "Loop": {
      "StepSeconds": 0.01,
      "ThreadCount": 2,
      "MaxCatchUpSteps": 10,
      "ShutdownTimeout": "00:00:05"
    },
    "Instances": {
      "MaxInstances": 40,
      "IdleTimeout": "00:30:00",
      "ExpiryCheckInterval": "00:00:05",
      "RecordingDirectory": "recordings",
      "RecordingSampleEverySteps": 10
    },
    "Modbus": {
      "BindAddress": "0.0.0.0",
      "PortRangeStart": 15000,
      "PortRangeEnd": 15999,
      "DefaultUnitId": 1,
      "PairingTimeout": "00:01:00",
      "RefusalCooldown": "00:01:00",
      "MaxPendingRequests": 8,
      "MaxConnections": 8,
      "PairingCheckInterval": "00:00:01"
    }
  }
}
